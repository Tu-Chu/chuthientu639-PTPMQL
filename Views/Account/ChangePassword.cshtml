@model DemoMVC.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-header">
            <span class="auth-icon">🛡️</span>
            <h1>Đổi mật khẩu</h1>
        </div>
        @if (TempData["StatusMessage"] != null)
        {
            <div class="auth-success">@TempData["StatusMessage"]</div>
        }
        <form asp-action="ChangePassword" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <label asp-for="CurrentPassword" class="form-label"></label>
            <input asp-for="CurrentPassword" class="form-control auth-input" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control auth-input" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control auth-input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            <button type="submit" class="auth-primary-button">Cập nhật</button>
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
