@model DemoMVC.Models.ForgotPasswordViewModel
@{ ViewData["Title"] = "Quên mật khẩu"; }

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-header">
            <span class="auth-icon">✉</span>
            <h1>Quên mật khẩu</h1>
            <p>Nhập email để nhận liên kết đặt lại mật khẩu.</p>
        </div>
        <form asp-action="ForgotPassword" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control auth-input" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
            <button type="submit" class="auth-primary-button">Gửi liên kết</button>
        </form>
        <a asp-action="Login" class="auth-link">← Quay lại đăng nhập</a>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
