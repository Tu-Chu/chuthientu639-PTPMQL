@{ ViewData["Title"] = "Kiểm tra email"; }
<div class="auth-shell">
    <div class="auth-card auth-result-card">
        <span class="auth-icon">📩</span>
        <h1>Kiểm tra hộp thư</h1>
        <p>@(TempData["StatusMessage"] ?? "Nếu email tồn tại, liên kết đặt lại mật khẩu đã được gửi.")</p>
        <a asp-action="Login" class="auth-primary-button">Quay lại đăng nhập</a>
    </div>
</div>
