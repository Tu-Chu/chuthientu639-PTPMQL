@model DemoMVC.Models.ResetPasswordViewModel
@{ ViewData["Title"] = "Tạo mật khẩu mới"; }
<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-header">
            <span class="auth-icon">🔐</span>
            <h1>Tạo mật khẩu mới</h1>
        </div>
        <form asp-action="ResetPassword" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <input asp-for="UserId" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control auth-input" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control auth-input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            <button type="submit" class="auth-primary-button">Cập nhật mật khẩu</button>
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
