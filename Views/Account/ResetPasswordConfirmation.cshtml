@{ ViewData["Title"] = "Đặt lại mật khẩu thành công"; }
<div class="auth-shell">
    <div class="auth-card auth-result-card">
        <span class="auth-icon">✅</span>
        <h1>Mật khẩu đã được cập nhật</h1>
        <p>Bạn có thể đăng nhập bằng mật khẩu mới.</p>
        <a asp-action="Login" class="auth-primary-button">Đăng nhập</a>
    </div>
</div>
