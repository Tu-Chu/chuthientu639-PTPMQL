@{
    ViewData["Title"] = "CRUD nhân viên với AJAX";
}

<section class="employee-page"
         id="employeePage"
         data-list-url="@Url.Action("GetAll", "Employees")"
         data-item-url="@Url.Action("GetById", "Employees")"
         data-create-url="@Url.Action("Create", "Employees")"
         data-update-url="@Url.Action("Update", "Employees")"
         data-delete-url="@Url.Action("Delete", "Employees")">
    <header class="employee-heading">
        <div>
            <p class="employee-eyebrow">Bài thực hành ASP.NET Core MVC</p>
            <h1>Quản lý nhân viên</h1>
            <p class="employee-subtitle">CRUD không tải lại trang, dùng fetch API và SQLite.</p>
        </div>
        <button class="employee-button employee-button-primary" type="button" id="addEmployeeButton">
            Thêm nhân viên
        </button>
    </header>

    <div class="employee-notice" id="employeeNotice" role="status" aria-live="polite" hidden></div>

    <div class="employee-list-controls">
        <label class="employee-search-field" for="employeeSearch">
            <span>Tìm nhân viên</span>
            <input id="employeeSearch"
                   type="search"
                   maxlength="100"
                   autocomplete="off"
                   placeholder="Họ tên, email hoặc phòng ban" />
        </label>
        <label class="employee-page-size-field" for="employeePageSize">
            <span>Số dòng</span>
            <select id="employeePageSize">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="50">50</option>
            </select>
        </label>
    </div>

    <div class="employee-table-wrap">
        <table class="employee-table">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Họ tên</th>
                    <th scope="col">Email</th>
                    <th scope="col">Phòng ban</th>
                    <th scope="col">Lương</th>
                    <th scope="col">Thao tác</th>
                </tr>
            </thead>
            <tbody id="employeeTableBody">
                <tr><td colspan="6">Đang tải dữ liệu...</td></tr>
            </tbody>
        </table>
    </div>

    <nav class="employee-pagination" aria-label="Phân trang danh sách nhân viên">
        <p id="employeePaginationInfo" aria-live="polite"></p>
        <div class="employee-pagination-actions">
            <button class="employee-button" type="button" id="previousPageButton" disabled>Trang trước</button>
            <span id="employeePageLabel" aria-current="page">Trang 1 / 1</span>
            <button class="employee-button" type="button" id="nextPageButton" disabled>Trang sau</button>
        </div>
    </nav>
</section>

<dialog class="employee-dialog" id="employeeDialog" aria-labelledby="employeeDialogTitle">
    <form id="employeeForm" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" />
        <header class="employee-dialog-heading">
            <h2 id="employeeDialogTitle">Thêm nhân viên</h2>
            <button class="employee-icon-button" type="button" data-close-dialog aria-label="Đóng">×</button>
        </header>

        <label class="employee-field">
            <span>Họ tên</span>
            <input name="fullName" type="text" maxlength="120" autocomplete="name" required />
            <small data-error-for="fullname"></small>
        </label>
        <label class="employee-field">
            <span>Email</span>
            <input name="email" type="email" maxlength="254" autocomplete="email" required />
            <small data-error-for="email"></small>
        </label>
        <label class="employee-field">
            <span>Phòng ban</span>
            <input name="department" type="text" maxlength="80" required />
            <small data-error-for="department"></small>
        </label>
        <label class="employee-field">
            <span>Lương (VND)</span>
            <input name="salary" type="number" min="0" step="1000" required />
            <small data-error-for="salary"></small>
        </label>
        <p class="employee-form-error" id="employeeFormError" role="alert"></p>

        <footer class="employee-dialog-actions">
            <button class="employee-button" type="button" data-close-dialog>Hủy</button>
            <button class="employee-button employee-button-primary" type="submit" id="saveEmployeeButton">Lưu nhân viên</button>
        </footer>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/employees.js" asp-append-version="true"></script>
}