@model DemoMVC.Models.PagedResult<DemoMVC.Models.Person>

@{
    ViewData["Title"] = "Danh sách người dùng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh sách người dùng</h1>
    <a asp-action="Create" class="btn btn-primary">Thêm mới</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input name="search" value="@Model.Search" class="form-control"
               placeholder="Tìm theo họ tên hoặc địa chỉ" />
    </div>
    <div class="col-md-3">
        <select name="pageSize" class="form-select">
            @foreach (var size in new[] { 5, 10, 20, 50 })
            {
                <option value="@size" selected="@(Model.PageSize == size)">@size dòng</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-secondary w-100">Tìm kiếm</button>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Họ tên</th>
            <th>Địa chỉ</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="3" class="text-center">Không tìm thấy dữ liệu phù hợp.</td></tr>
        }
        else
        {
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.Address</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.PersonId" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.PersonId" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.TotalPages > 0)
{
    var firstItem = Model.TotalCount == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    var lastItem = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);

    <div class="d-flex justify-content-between align-items-center">
        <span>Hiển thị @firstItem-@lastItem trong @Model.TotalCount bản ghi</span>
        <nav aria-label="Phân trang người dùng">
            <ul class="pagination mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : null)">
                    <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                       asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize">Trước</a>
                </li>
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : null)">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                           asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)">
                    <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                       asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
}