<!-- Views/Products/Index.cshtml -->
@{
    ViewData["Title"] = "Quản lý Sản phẩm (AJAX)";
}

<div class="container mt-4" id="productPage"
     data-list-url="@Url.Action("GetAll", "Products")"
     data-item-url="@Url.Action("GetById", "Products")"
     data-create-url="@Url.Action("Create", "Products")"
     data-update-url="@Url.Action("Update", "Products")"
     data-delete-url="@Url.Action("Delete", "Products")">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách sản phẩm</h2>
        <button class="btn btn-primary" id="btnOpenCreate" type="button">+ Thêm sản phẩm</button>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-8">
            <input id="productSearch" type="search" class="form-control"
                   placeholder="Tìm theo tên sản phẩm" maxlength="100" />
        </div>
        <div class="col-md-4">
            <select id="productPageSize" class="form-select">
                <option value="5">5 dòng</option>
                <option value="10" selected>10 dòng</option>
                <option value="20">20 dòng</option>
                <option value="50">50 dòng</option>
            </select>
        </div>
    </div>

    <div id="productNotice" class="alert d-none" role="status"></div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
                <th>Tồn kho</th>
                <th style="width: 160px;">Thao tác</th>
            </tr>
        </thead>
        <tbody id="productTableBody">
            <tr><td colspan="5" class="text-center">Đang tải dữ liệu...</td></tr>
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <span id="productPaginationInfo"></span>
        <nav aria-label="Phân trang sản phẩm">
            <div class="btn-group">
                <button id="previousProductPage" class="btn btn-outline-secondary" type="button" disabled>Trang trước</button>
                <span id="productPageLabel" class="btn btn-outline-secondary disabled">Trang 1 / 1</span>
                <button id="nextProductPage" class="btn btn-outline-secondary" type="button" disabled>Trang sau</button>
            </div>
        </nav>
    </div>
</div>

<!-- Modal Thêm / Sửa -->
<div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="productForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Sản phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="ProductId" value="0" />

                    <div class="mb-3">
                        <label class="form-label" for="Name">Tên sản phẩm</label>
                        <input type="text" class="form-control" id="Name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="Price">Giá</label>
                        <input type="number" step="0.01" class="form-control" id="Price" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="Stock">Số lượng</label>
                        <input type="number" class="form-control" id="Stock" required />
                    </div>

                    <div id="formError" class="text-danger small"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success" id="btnSave">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/products.js" asp-append-version="true"></script>
}