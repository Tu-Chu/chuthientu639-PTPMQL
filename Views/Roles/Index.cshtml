@model List<DemoMVC.Models.RoleListItemViewModel>
@{ ViewData["Title"] = "Quản lý Role"; }

<div class="role-admin-page">
    <div class="role-admin-heading">
        <div>
            <p class="role-eyebrow">Bảng điều khiển quản trị</p>
            <h1>Quản lý Role</h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="UserRoles" class="role-button role-button-secondary">Gán role người dùng</a>
            <a asp-action="Create" class="role-button role-button-primary">+ Tạo role</a>
        </div>
    </div>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="role-alert role-alert-success">@TempData["StatusMessage"]</div>
    }
    @if (TempData["StatusError"] != null)
    {
        <div class="role-alert role-alert-danger">@TempData["StatusError"]</div>
    }

    <div class="role-table-card">
        <table class="role-table">
            <thead><tr><th>Tên role</th><th>Số người dùng</th><th>Thao tác</th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="3" class="text-center">Chưa có role nào.</td></tr>
            }
            else
            {
                foreach (var role in Model)
                {
                    <tr>
                        <td><span class="role-name-badge">@role.Name</span></td>
                        <td>@role.UserCount</td>
                        <td class="role-actions">
                            <a asp-action="Edit" asp-route-id="@role.Id" class="role-button role-button-secondary role-button-small">Sửa</a>
                            @if (role.Name != "Admin")
                            {
                                <form asp-action="Delete" asp-route-id="@role.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Bạn có chắc muốn xóa role này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="role-button role-button-danger role-button-small">Xóa</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
